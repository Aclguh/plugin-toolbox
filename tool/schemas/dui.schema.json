{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Aclguh/plugin-toolbox/master/tool/schemas/dui.schema.json",
  "title": "PluginToolbox Declarative UI (DUI) Schema",
  "description": "JSON Schema specification for PluginToolbox declarative UI JSON AST definitions",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Container",
        "Column",
        "Row",
        "Stack",
        "Wrap",
        "SingleChildScrollView",
        "Text",
        "SelectableText",
        "Button",
        "IconButton",
        "TextField",
        "Switch",
        "Slider",
        "Dropdown",
        "ProgressBar",
        "Divider",
        "Card",
        "ListTile",
        "Tabs",
        "Repeater",
        "Image",
        "Icon",
        "MarkdownView",
        "Html",
        "DrawingPad",
        "SignaturePad",
        "Canvas",
        "PixelGrid",
        "Chart"
      ],
      "description": "Registered DUI component type name"
    },
    "visible": {
      "description": "Visibility expression, e.g. '{{state.is_visible}}' or boolean literal"
    },
    "ref": {
      "type": "string",
      "description": "Optional component reference name for direct state query or focus manipulation"
    },
    "props": {
      "type": "object",
      "description": "Component properties and style definitions",
      "additionalProperties": true
    },
    "events": {
      "type": "object",
      "description": "Event handler bindings mapping event names to action descriptors or script callbacks",
      "additionalProperties": true
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#"
      },
      "description": "Child DUI component nodes"
    }
  },
  "additionalProperties": true
}
